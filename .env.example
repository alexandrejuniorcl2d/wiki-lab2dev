# Copie para .env e ajuste. O .env nunca vai para o Git.

# Endereço público do wiki
#   Local:    :80                (HTTP em http://localhost)
#   Produção: wiki.lab2dev.com   (HTTPS automático; o DNS precisa apontar para o servidor)
WIKI_DOMAIN=:80

# Banco de dados
# A senha só é aplicada na PRIMEIRA subida do Postgres (volume vazio).
# Gere uma forte com: openssl rand -base64 32
DB_NAME=wiki
DB_USER=wikijs
DB_PASS=troque-por-uma-senha-forte

# Dias de retenção dos dumps diários em ./backups
BACKUP_RETENTION_DAYS=7

# Scripts de conteúdo (npm run setup / import)
# Chave criada em Admin > API Access. Dê validade curta e revogue quando não precisar mais.
WIKI_URL=http://localhost
WIKI_API_TOKEN=

# Produção no Supabase (scripts/migrate-to-supabase.sh, backup e restore)
# Connect → Session pooler no painel do Supabase
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
